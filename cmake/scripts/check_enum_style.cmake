# Fails when an enum value in include/ or src/ is not CapitalCase.
# Usage: cmake -DSOURCE_DIR=<repo root> -P check_enum_style.cmake
#
# CapitalCase: leading upper-case letter, no underscore, and not all upper-case
# unless it is one letter plus digits (I64, S). `typedef enum` declarations are
# C enums in headers that compile as plain C and are skipped.

if(NOT SOURCE_DIR)
  message(FATAL_ERROR "check_enum_style: pass -DSOURCE_DIR=<repo root>")
endif()

file(GLOB_RECURSE SOURCES
  "${SOURCE_DIR}/include/*.h" "${SOURCE_DIR}/include/*.hpp"
  "${SOURCE_DIR}/src/*.h" "${SOURCE_DIR}/src/*.hpp" "${SOURCE_DIR}/src/*.cpp"
  "${SOURCE_DIR}/src/*.c" "${SOURCE_DIR}/src/*.cc" "${SOURCE_DIR}/src/*.inl")
list(SORT SOURCES)

set(HITS "")
set(HIT_COUNT 0)
set(ENUM_COUNT 0)
set(ENUM_WITH_HITS 0)
set(NEWLINE "\n")

foreach(file IN LISTS SOURCES)
  file(READ "${file}" content)
  string(FIND "${content}" "enum" has_enum)
  if(has_enum EQUAL -1)
    continue()
  endif()

  string(REGEX REPLACE "//[^\n]*" "" content "${content}")
  while(TRUE)
    string(REGEX MATCH "/\\*([^*]|\\*+[^*/])*\\*+/" comment "${content}")
    if(comment STREQUAL "")
      break()
    endif()
    string(REGEX MATCHALL "\n" comment_newlines "${comment}")
    string(REPLACE ";" "" comment_newlines "${comment_newlines}")
    string(FIND "${content}" "${comment}" comment_pos)
    string(LENGTH "${comment}" comment_len)
    string(SUBSTRING "${content}" 0 ${comment_pos} head)
    math(EXPR tail_pos "${comment_pos} + ${comment_len}")
    string(SUBSTRING "${content}" ${tail_pos} -1 tail)
    set(content "${head}${comment_newlines}${tail}")
  endwhile()

  file(RELATIVE_PATH rel "${SOURCE_DIR}" "${file}")
  set(rest "${content}")
  set(consumed 0)
  while(TRUE)
    string(REGEX MATCH
      "(typedef)?(^|[^A-Za-z0-9_])enum[ \t\r\n]+([A-Za-z_][A-Za-z0-9_ \t\r\n:<>]*)?\\{[^}]*\\}"
      decl "${rest}")
    if(decl STREQUAL "")
      break()
    endif()
    string(FIND "${rest}" "${decl}" decl_pos)
    string(LENGTH "${decl}" decl_len)
    string(SUBSTRING "${rest}" 0 ${decl_pos} before)
    string(REGEX MATCHALL "\n" before_nl "${before}")
    list(LENGTH before_nl before_lines)
    math(EXPR next_pos "${decl_pos} + ${decl_len}")
    string(SUBSTRING "${rest}" ${next_pos} -1 rest)

    set(base_line ${consumed})
    string(REGEX MATCHALL "\n" decl_nl "${decl}")
    list(LENGTH decl_nl decl_lines)
    math(EXPR consumed "${consumed} + ${before_lines} + ${decl_lines}")
    math(EXPR decl_line "${base_line} + ${before_lines} + 1")
    if(decl MATCHES "^\n")
      math(EXPR decl_line "${decl_line} + 1")
    endif()

    if(decl MATCHES "^typedef")
      continue()
    endif()
    math(EXPR ENUM_COUNT "${ENUM_COUNT} + 1")

    string(REGEX MATCH "\\{.*" body "${decl}")
    string(REGEX REPLACE "^\\{" "" body "${body}")
    string(REGEX REPLACE "\\}$" "" body "${body}")
    string(REGEX REPLACE "(^|\n)[ \t]*#[^\n]*" "\\1" body "${body}")
    while(body MATCHES "\\([^()]*\\)")
      string(REGEX REPLACE "\\([^()]*\\)" "" body "${body}")
    endwhile()
    string(REGEX REPLACE "=[^,]*" "" body "${body}")
    string(REGEX MATCH "enum[^{]*\\{" head_decl "${decl}")
    string(REGEX MATCHALL "\n" head_nl "${head_decl}")
    list(LENGTH head_nl head_lines)
    math(EXPR body_line "${decl_line} + ${head_lines}")

    set(enum_had_hit FALSE)
    string(REPLACE "\n" "\n;" body_lines "${body}")
    foreach(line IN LISTS body_lines)
      string(REPLACE "\n" "" line_text "${line}")
      string(REPLACE "," ";" parts "${line_text}")
      foreach(part IN LISTS parts)
        string(REGEX MATCH "[A-Za-z_][A-Za-z0-9_]*" value "${part}")
        if(NOT value STREQUAL "")
          set(ok FALSE)
          if(value MATCHES "^[A-Z][A-Za-z0-9]*$")
            set(ok TRUE)
            if(value MATCHES "^[A-Z0-9]+$" AND NOT value MATCHES "^[A-Z][0-9]*$")
              set(ok FALSE)
            endif()
          endif()
          if(NOT ok)
            string(APPEND HITS "${rel}:${body_line}: ${value}\n")
            math(EXPR HIT_COUNT "${HIT_COUNT} + 1")
            set(enum_had_hit TRUE)
          endif()
        endif()
      endforeach()
      if(line MATCHES "\n$")
        math(EXPR body_line "${body_line} + 1")
      endif()
    endforeach()
    if(enum_had_hit)
      math(EXPR ENUM_WITH_HITS "${ENUM_WITH_HITS} + 1")
    endif()
  endwhile()
endforeach()

if(HIT_COUNT GREATER 0)
  message("${HITS}")
  message(FATAL_ERROR
    "enum_style: ${HIT_COUNT} enum values in ${ENUM_WITH_HITS} of ${ENUM_COUNT} enums are not CapitalCase")
endif()
message(STATUS "enum_style: ${ENUM_COUNT} enums, every value is CapitalCase")
