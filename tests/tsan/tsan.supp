# ThreadSanitizer suppressions for known-benign, third-party first-use races.
#
# Note: zlib-ng's analogous lazy functable init race is NOT suppressed here -
# it is eliminated by warming zlib single-threaded in Executor::start().

# libstdc++ counts exception_ptr references with atomics inside libsupc++,
# which is not instrumented, so the free of an exception a future handed to
# another thread looks unordered with that thread's reads.
race:std::__exception_ptr::exception_ptr::_M_release
race:std::logic_error::~logic_error
race:std::runtime_error::~runtime_error

# zstd's dictionary builder stores its log level in a global on every call.
# Parallel trainings write the same value. The level only gates debug output.
race:g_displayLevel
