    def __init__(
        self,
        files: Sequence[str],
        index_path: Optional[str] = ...,
    ) -> None: ...
    def snapshot(self) -> "TraceViewer":
        """Index what was written since the last call; a TraceViewer of every whole member."""
        ...
    def new_rows(self) -> Optional["TraceViewer"]:
        """As snapshot; a TraceViewer of the rows no earlier call returned, or None."""
        ...
    def status(self) -> List[Tuple[str, str, int, int, int]]:
        """(path, state, verified_bytes, skipped_bytes, hole_bytes) per file."""
        ...

class TraceViewer:
    """A trace scan and the plan over it. Builders return a new TraceViewer;
    lazy() is the plan as a LazyFrame, and the plan-returning terminals give
    a LazyFrame that runs on collect()."""

    def __init__(
        self,
        files: Union[str, Sequence[str]],
        index_path: Optional[str] = ...,
    ) -> None:
        """``files`` is a trace path, a sequence of paths, or a directory; a
        directory is scanned recursively for ``.pfw.gz`` traces."""
        ...
    def lazy(self) -> PublicLazyFrame:
        """The plan as a LazyFrame."""
        ...
    def with_lazy(self, plan: PublicLazyFrame) -> Self:
        """This scan with ``plan`` (a LazyFrame over it) as its plan."""
        ...
    def filter(self, dsl: object) -> Self:
        """Keep events matching a duql predicate (``str(dsl)``)."""
        ...
    def duql(
        self,
        text: str,
        params: Mapping[str, Union[bool, int, float, str, Sequence[Union[bool, int, float, str]]]],
    ) -> Self:
        """The duql pipeline ``text`` over this view, ``params`` bound."""
        ...
    def explain_duql(
        self,
        text: str,
        params: Mapping[str, Union[bool, int, float, str, Sequence[Union[bool, int, float, str]]]],
    ) -> str:
        """The plan duql() builds, one step per line."""
        ...
    def select(self, names: Sequence[str]) -> Self:
        """Fields the scan reads (raw events), or a projection of the plan. A
        name without the ``args.`` prefix that is not an envelope field
        (``dur.p99``) reads ``args.<name>``, as in filter."""
        ...
    def phase(
        self, phase: Literal["events", "counters", "aggregated", "metadata", "any"]
    ) -> Self: ...
    def time_range(self, begin: float, end: float, /) -> Self:
        """Keep events starting in [begin, end); occupancy clips to it."""
        ...
    def time_bucket(
        self, interval_us: int, normalize_to: Union[int, Literal["min"], None] = None
    ) -> Self: ...
    def resolution(self, cell_us: int, /) -> Self:
        """Grid in microseconds the occupancy aggregates snap to; 0 is exact."""
        ...
    def time_scale(self, ns_ratio: float, /) -> Self: ...
    def time_unit(self, unit: Literal["ns", "us", "ms", "sec", "s"], /) -> Self: ...
    def group_by(self, *keys: str) -> Self: ...
    def agg(self, *specs: str) -> Self: ...
    def agg_numeric_args(self, *reductions: str) -> Self: ...
    def record_schema(self, id: str, /) -> Self: ...
    def rollup_root(self, path: str, /) -> Self: ...
    def views_root(self, path: str, /) -> Self: ...
    def memory_budget(self, nbytes: int, /) -> Self: ...
    def columns(self) -> List[str]:
        """Columns discoverable from the index, nested args as dotted paths
        with one per array element (``hosts.1``). No trace scan."""
        ...
    def schema_tree(self) -> str: ...
    def column_info(self) -> Dict[str, str]:
        """Index columns mapped to their type ("int64"/"float64"/"string").
        No trace scan."""
        ...
    def time_metric(self) -> str:
        """The trace's own time unit ("us"/"ns"/"ms"/"sec")."""
        ...
    def aggregates(self) -> bool:
        """True when the plan absorbs into an aggregating scan."""
        ...
    def filters_events(self) -> bool:
        """True while a filter still selects raw events. Reads no index."""
        ...
    def call_tree(
        self,
        partition: Optional[Sequence[str]] = ...,
        ts: str = ...,
        dur: str = ...,
        name: str = ...,
    ) -> PublicLazyFrame:
        """Plan of the events plus containment level/parent_id per lane."""
        ...
    def flamegraph(
        self,
        partition: Optional[Sequence[str]] = ...,
        ts: str = ...,
        dur: str = ...,
        name: str = ...,
        group: Optional[Sequence[str]] = ...,
    ) -> PublicLazyFrame:
        """Plan of the folded flamegraph node frame."""
        ...
    def containment(
        self,
        partition: Optional[Sequence[str]] = ...,
        ts: str = ...,
        dur: str = ...,
        name: str = ...,
        group: Optional[Sequence[str]] = ...,
    ) -> Tuple[PublicLazyFrame, PublicLazyFrame]:
        """(call_tree plan, flamegraph plan) sharing one buffered fold."""
        ...
    def flamegraph_partial(
        self,
        partition: Optional[Sequence[str]] = ...,
        ts: str = ...,
        dur: str = ...,
        name: str = ...,
        group: Optional[Sequence[str]] = ...,
    ) -> PublicLazyFrame:
        """Plan of a one-row frame whose ``partial`` column holds the
        serialized flamegraph partial."""
        ...
    def aggregate_partial(self) -> PublicLazyFrame:
        """Plan of a one-row frame whose ``partial`` column holds the
        serialized aggregation partial."""
        ...
    def sink_json(self, path: str, /) -> PublicLazyFrame:
        """Plan writing the selected events to ``path``; yields one stats row."""
        ...
    def typed(
        self,
        shard_begin: int = 0,
        shard_end: int = 0,
        progress: Optional[Callable[[int, int], None]] = None,
        runtime: Optional[object] = None,
    ) -> CollectTypedResult:
        """The aggregation index's record families over shard range
        ``[shard_begin, shard_end)`` (0 = all). Runs now."""
        ...
    def materialize(
        self,
        checkpoint_size: int = 0,
        part_size: int = 0,
        progress: Optional[Callable[[int, int], None]] = None,
        runtime: Optional[object] = None,
    ) -> Dict[str, object]:
        """Persist this query as a materialized view. Runs now; returns the
        scan stats."""
        ...
    def export_trace(
        self,
        path: str,
        compress: bool = True,
        index: bool = False,
        member_size: int = 0,
        level: int = 6,
        part_size: int = 0,
        runtime: Optional[object] = None,
    ) -> Dict[str, object]:
        """Write a trace file now; returns the scan stats."""
        ...
    def merge_partials(self, partials: Sequence[bytes], /) -> "PublicDataFrame":
        """Merge aggregate partials with this aggregation. No scan."""
        ...
    def materialize_partials(
        self, partials: Sequence[bytes], runtime: Optional[object] = None
    ) -> None:
        """Write the rollup from partials."""
        ...
    def reconstruct_if_cached(self) -> Optional["PublicDataFrame"]:
        """The rollup as a DataFrame, or None on a miss."""
        ...
    def mv_source(self) -> List[str]:
        """Materialized-view files that would serve this query, or []."""
        ...
    def materialize_dir(self) -> str:
        """Create and return the shared materialized-view directory."""
        ...
    def register_materialized(self, dir: str, /) -> None:
        """Write the materialized-view manifest at ``dir``."""
        ...
    def compare(self, other: "PublicTraceViewer", /) -> PublicLazyFrame:
        """Plan comparing this aggregation against ``other``'s events."""
        ...
    def plugins(self, host: "Plugins", /) -> PublicLazyFrame:
        """Plan folding a Plugins set over the scan; plugin_results(host)
        reads the results after the collect."""
        ...

class PluginRecord(TypedDict):
    """One plugin's entry in :meth:`Plugins.describe`."""

    path: str
    abi_version: int
    has_plan_duql: bool
    has_fold: bool
    provides: List[str]
    consumes: List[str]
    ops: List[str]
    udfs: List[str]
    udafs: List[str]
    states: List[str]
    providers: List[str]
    nodes: List[str]
    index_extensions: List[str]
    file_formats: List[str]
    sinks: List[str]
    reads: List[str]
    config_keys: List[str]

class Plugins:
    """A fixed, built set of compiled DFTracer plugins."""

    def __init__(
        self,
        specs: "List[Tuple[str, Optional[str]]]",
        result_names: Optional[Dict[str, str]] = ...,
        runtime: Optional[object] = ...,
    ) -> None:
        """Build every ``(path, config_json_or_None)`` spec now; raises
        ImportError on a load/symbol/ABI/capability failure."""
        ...
    def describe(self) -> List[PluginRecord]:
        """One plain dict per loaded plugin, in registration order: ``path``,
        ``abi_version``, ``has_plan_duql``, ``has_fold``, and the names it
        registered per kind (``ops``, ``udfs``, ``udafs``, ``states``,
        ``providers``, ``nodes``, ``index_extensions``, ``file_formats``,
        ``sinks``), plus ``provides``, ``consumes``, ``reads`` and
        ``config_keys``. Static: nothing is scanned.
        """
        ...
    def run(
        self,
        traces: "str | List[str]",
        index_dir: Optional[str] = ...,
        auto_index: bool = ...,
    ) -> "Tuple[Dict[str, _RunResultValue], Dict[str, int]]":
        """Fold every plugin in the set over one fused scan; returns
        ``({name: bytes | DataFrame | LazyFrame}, {events_scanned, events_matched})``.
        """
        ...

