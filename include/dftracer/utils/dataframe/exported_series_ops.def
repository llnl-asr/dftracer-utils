DFTU_SERIES_OP(dftu.series.str_ends_with, dftu_series_str_ends_with, SERIES, SERIES, STR,
               NONE)
DFTU_SERIES_OP(dftu.series.str_matches, dftu_series_str_matches, SERIES, SERIES, STR, NONE)
DFTU_SERIES_OP(dftu.series.str_search, dftu_series_str_search, SERIES, SERIES, STR, NONE)
DFTU_SERIES_OP(dftu.series.str_like, dftu_series_str_like, SERIES, SERIES, STR, NONE)
DFTU_SERIES_OP(dftu.series.str_find, dftu_series_str_find, SERIES, SERIES, STR, NONE)

/* String lengths / case / trim. */
DFTU_SERIES_OP(dftu.series.str_len_bytes, dftu_series_str_len_bytes, SERIES, SERIES, NONE,
               NONE)
DFTU_SERIES_OP(dftu.series.str_len_chars, dftu_series_str_len_chars, SERIES, SERIES, NONE,
               NONE)
DFTU_SERIES_OP(dftu.series.to_lowercase, dftu_series_to_lowercase, SERIES, SERIES, NONE,
