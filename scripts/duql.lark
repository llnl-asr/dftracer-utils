// duql grammar for Lark's LALR(1) generator. Checked by
// scripts/check_duql_grammar.py.

start: pragma? decl* pipeline?

pragma: "duql" INT

decl: "let" NAME "=" pipeline ";"                    -> let_decl
    | "def" NAME params? "=" def_body ";"            -> def_decl
    | "source" NAME "{" [member (";" member)* ";"?] "}" -> source_decl

params: "(" [NAME ("," NAME)*] ")"

def_body: expr
        | plain_stage ("|" stage)*                   -> stage_pipeline
        | expr ("|" stage)+                          -> filter_pipeline

member: NAME "=" pipeline                           -> member_rowset
      | "def" NAME params? "=" def_body                -> member_def

?pipeline: from_pipeline
         | plain_stage ("|" stage)*                   -> stage_pipeline
         | expr ("|" stage)*                          -> filter_pipeline

from_pipeline: "from" src ("," src)* ("|" stage)*

src: STRING | NAME | PARAM

// Stages. Stage names are contextual: the contextual lexer offers them
// only where a stage may start.
stage: plain_stage
     | NAME "(" [arg ("," arg)*] ")"                  -> use_stage

plain_stage: "where" expr                                   -> where
     | "derive" asg ("," asg)*                        -> derive
     | "parse" path "~" (STRING | PARAM)               -> parse
     | "select" (item | pattern) ("," (item | pattern))* -> select
     | "drop" (path | pattern) ("," (path | pattern))* -> drop
     | "rename" NAME "=" path ("," NAME "=" path)*    -> rename
     | "distinct" [item ("," item)*]                  -> distinct
     | "group" item ("," item)* block                 -> group
     | "agg" block                                    -> agg
     | "window" [item ("," item)*] ["sort" keys] block -> window
     | "pivot" add_expr ["in" "[" [pivot_value ("," pivot_value)*] "]"] block -> pivot
     | "unpivot" (path | pattern) ("," (path | pattern))* "as" NAME "," NAME  -> unpivot
     | "sort" keys                                    -> sort
     | "take" (INT | PARAM) (".." (INT | PARAM) | ["by" expr ("," expr)* ["sort" keys]]) -> take
     | "skip" (INT | PARAM)                                    -> skip
     | "sample" (number | PARAM) ["%"] ["seed" (INT | PARAM)] -> sample
     | "expand" path ["as" NAME] ["with_index" NAME] ["keep_empty"] -> expand
     | "lookup" ("(" from_pipeline ")" | NAME) "on" join_key ("," join_key)* [lookup_tail] -> lookup
     | "union" ("(" from_pipeline ")" | NAME | STRING) -> union
     | "call" dotted "(" [arg ("," arg)*] ")"         -> call_stage
     | "time_range" (expr ".." [expr] | ".." expr) ["overlap"] -> time_range
     | "call_tree"                                    -> call_tree
     | "bucket" expr ["every" expr] ["at" expr] ["fill" [("forward" | "linear")] ["from" expr "to" expr]] ["as" NAME]             -> bucket
     | "session" [item ("," item)*] "gap" expr ["max" expr] ["as" NAME] -> session

block: "{" [asg ("," asg)*] "}"
pivot_value: expr ["as" NAME]
asg: NAME "=" expr | expr
item: expr ["as" NAME] | NAME "=" expr
keys: sort_key ("," sort_key)*
// A leading "-" is always the direction: the undirected key cannot start
// with a unary minus.
sort_key: ("-" expr | or_ns) ["nulls" ("first" | "last")]
?or_ns: and_ns ("or" and_expr)*
?and_ns: not_ns ("and" not_expr)*
?not_ns: NOT cmp_expr | cmp_ns
?cmp_ns: add_ns
       | add_ns cmp_op add_expr
       | add_ns [NOT] "in" (list | subquery | path | call | PARAM)
       | add_ns [NOT] "between" add_expr "and" add_expr
       | add_ns [NOT] ("like" | "ilike") (STRING | PARAM) ["escape" STRING]
       | add_ns "is" [NOT] (NULL | MISSING)
?add_ns: mul_ns (("+" | "-") mul_expr)*
?mul_ns: coalesce (("*" | "/" | "//" | "%") unary)*
join_key: add_expr ["==" add_expr]
lookup_tail: "into" NAME
           | "inner" ["into" NAME]
           | "anti"
           | "overlap" ["into" NAME]
           | "asof" join_key ["backward" | "forward" | "nearest"] ["within" add_expr]

// Expressions.
?expr: or_expr
?or_expr: and_expr ("or" and_expr)*
?and_expr: not_expr ("and" not_expr)*
?not_expr: NOT cmp_expr | cmp_expr
?cmp_expr: add_expr
         | add_expr cmp_op add_expr                              -> compare
         | add_expr [NOT] "in" (list | subquery | path | call | PARAM)          -> in_expr
         | add_expr [NOT] "between" add_expr "and" add_expr      -> between
         | add_expr [NOT] ("like" | "ilike") (STRING | PARAM) ["escape" STRING]       -> like
         | add_expr "is" [NOT] (NULL | MISSING)                  -> is_expr
?add_expr: mul_expr (("+" | "-") mul_expr)*
?mul_expr: unary (("*" | "/" | "//" | "%") unary)*
?unary: "-" coalesce -> neg
      | coalesce
?coalesce: postfix ("??" postfix)*
?postfix: primary
        | call OVER over_width [ROWS]                 -> over
        | postfix "->" NAME ["(" path ")"] "." path   -> arrow
?primary: literal
        | PARAM
        | path
        | indexed
        | call
        | quant
        | "(" expr ")"
        | tuple
        | list
        | subquery
        | case_block

// `case {` and `else =>` are keywords only there; `case(...)` stays a call.
case_block: CASE "{" case_arm ("," case_arm)* ["," ELSE "=>" expr] "}"
          | CASE "{" ELSE "=>" expr "}"
case_arm: expr "=>" expr
CASE.2: /case(?=\s*\{)/i
ELSE.2: /else(?=\s*=>)/i

// `over` and `rows` are keywords only after a call.
over_width: INT | FLOAT | DURATION | PARAM
OVER.2: /over(?=\s+[0-9$])/i
ROWS.2: /rows(?![A-Za-z0-9_])/i

subquery: "(" from_pipeline ")"
tuple: "(" expr "," expr ("," expr)* ")"
list: "[" [expr ("," expr)*] "]"
call: (dotted | ANYALL) "(" [arg ("," arg)*] ")"
// A wildcard `*` replaces a key after the first; it is not a name. A
// pattern stands alone in select, drop, unpivot and any()/all().
quant: ANYALL "(" pattern ")"
pattern: dotted "." "*" pattern_step*
pattern_step: "." (NAME | QKEY | "*")
ANYALL.2: /(any|all)(?=\s*\()/i
arg: expr | NAME "=" expr

// A path whose leading keys are plain names shares its prefix with a
// dotted call name; the parser reduces only when it sees "(" or not.
path: dotted
    | dotted path_tail path_step*
    | QKEY path_step*
    | "." [pkey path_step*]
    | "^" "." pkey path_step*
dotted: NAME | dotted "." NAME
path_tail: "." (QKEY | INT | FLOAT) | INDEX
path_step: "." pkey | INDEX
// A bracket that is not [-]INT is a computed index; it ends the path.
indexed: path "[" expr "]"
?pkey: NAME | QKEY | INT | FLOAT

?literal: number | STRING | DURATION | TRUE | FALSE | NULL
?number: INT | FLOAT

!cmp_op: "==" | "!=" | "<" | "<=" | ">" | ">=" | "~" | "~*" | "!~" | "!~*"
NOT: "not"
NULL: "null"
MISSING: "missing"
TRUE: "true"
FALSE: "false"

// Reserved in expressions: never a NAME. Backticks quote such a key.
NAME: /(?!(and|or|not|in|like|ilike|between|is|escape|null|true|false|missing)\b)[A-Za-z_][A-Za-z0-9_]*/
QKEY: /`[^`]+`/
PARAM: /\$[A-Za-z_][A-Za-z0-9_]*/
DURATION.2: /[0-9]+(\.[0-9]+)?(ns|us|ms|s|m|h)(?![A-Za-z0-9_])/
FLOAT: /[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+/
INT: /[0-9]+/
INDEX.2: /\[\s*-?\s*[0-9]+\s*\]/
STRING: /"(\\.|[^"\\])*"|'(\\.|[^'\\])*'/

COMMENT: /#[^\n]*/
%import common.WS
%ignore WS
%ignore COMMENT
