cat == "POSIX" and dur >= 1000
---
name like "%Send%"
---
name ilike "%send%" escape "\\"
---
"io" in cat
---
"io" not in cat
---
a ~* "x"
---
a !~ "^x" or b ~ "y"
---
not a == 1
---
any(tags) == "y"
---
x is null or y is not missing
---
ts between 1s and 5s and dur > 250ms
---
x in [1, 2, 3] and y not in ['a', 'b']
---
5-3 == 2 and -x < 10us and a // 2 % 3 == 1.5 * 2 / 4
---
(a ?? b) + 1 > 5ns
---
args.`cpu.idle_pct` > 0.5 and hosts[0].name == $host and a[-1] == 1
---
`from` == 1 and counters.`cpu.idle_pct`.p50 > 2
---
x not in (from runs | select run)
---
x in (from "a.pfw.gz", $f, runs | where y > 1)
---
run in (from runs | where app == "laghos" | select run)
---
run -> runs.app == "laghos"
---
run -> runs(id).app == "laghos"
---
run -> runs.system -> systems.cpu == "a64fx"
---
(run, host) -> hosts.name != "h1"
---
myplug.entropy(args.data, n = 5) > 0.5
---
any(hosts, .ok) and all(tags, . != 'x') and ^.id == 1
---
where x > 1 | derive y = x * 2, z = y + 1
---
from "a.pfw.gz", 'b.pfw.gz' | select name, dur as d, t = ts // 1000
---
from all | drop args.x, pid | rename p = pid, t = tid
---
distinct | distinct name, cat
---
group name, cat { n = count(), total = sum(dur), p = quantile(dur, 0.99) }
---
agg { n = count(), busy = busy() }
---
window name sort ts { r = row_number(), prev = lag(dur, 1) }
---
window { r = running_sum(dur) }
---
pivot cat in ["POSIX", "STDIO"] { n = count() }
---
pivot cat { t = sum(dur) }
---
unpivot read_bytes, write_bytes as kind, bytes
---
sort -dur, name nulls first, ts nulls last, - -x, a - b
---
take 10 | take 5 by name sort -dur | skip 3
---
sample 100 seed 7 | sample 12.5 % | sample 5 %
---
expand hosts as h with_index i keep_empty | where .ok and ^.id == 1
---
lookup runs on run | lookup hosts on (run, host) into hs | expand hs keep_empty
---
lookup runs on run == id, (a, b) == (c, d), -x == y + 1 into r
---
lookup s on pid asof ts == t | lookup s on pid asof ts forward within 5 | lookup s on (a, b) == (c, d) asof ts nearest within $w
---
lookup s on pid overlap | lookup s on (a, b) == (c, d) overlap into m
---
union (from runs | select run)
---
call myplug.table(x, n = 5) | call_tree
---
time_range 1s .. 5s overlap | bucket 100ms fill
---
time_range $start..$end | bucket 1m
---
duql 1
