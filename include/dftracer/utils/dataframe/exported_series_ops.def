DFTU_SERIES_OP(dftu.series.sqrt, dftu_series_sqrt, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.exp, dftu_series_exp, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.log, dftu_series_log, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.cumsum, dftu_series_cumsum, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.cummax, dftu_series_cummax, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.cummin, dftu_series_cummin, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.cum_prod, dftu_series_cum_prod, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.cum_count, dftu_series_cum_count, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.diff, dftu_series_diff, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.pct_change, dftu_series_pct_change, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.null_mask, dftu_series_null_mask, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.valid_mask, dftu_series_valid_mask, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.is_nan, dftu_series_is_nan, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.is_finite, dftu_series_is_finite, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.is_infinite, dftu_series_is_infinite, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.is_unique, dftu_series_is_unique, SERIES, SERIES, NONE, NONE)
