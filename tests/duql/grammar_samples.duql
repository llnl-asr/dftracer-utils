---
source dftracer {
    data    = where ph != "M";
    files   = where ph == "M" and name == "FH" | select id = args.value, path = args.name;
    hosts   = where ph == "M" and name == "HH" | select id = args.value, name = args.name;
    strings = where ph == "M" and name == "SH" | select id = args.value, value = args.name;
    def ms(x) = x / 1000;
    def args_fallback = true
}
where ms(dur) > 1   # trailing comment
