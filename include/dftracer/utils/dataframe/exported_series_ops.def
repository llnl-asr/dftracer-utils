/* Built-in dataframe column ops seeded into the op registry, one per line.
 * APPEND ONLY - a name is a stable public key; never rename or repurpose one.
 *
 *   DFTU_SERIES_OP(name, fn, ret, o0, o1, o2)
 *     name        - registry key (lower_snake), under the host namespace:
 *                   `dftu.series.<op>` for a built-in column op, or
 *                   `dftu.<family>.<op>` for a host utility a plugin calls
 *                   through dftu.svc.ops. The `dftu.` prefix is ours: a
 *                   plugin registering one is refused at the plugin seam, so
 *                   a plugin can never shadow a host op. <family> is the
 *                   source module the utility comes from (hash ->
 *                   core/common/hash, hex -> the scalar hex codecs, text ->
 *                   utilities/text, fs -> utilities/filesystem, file ->
 *                   utilities/fileio). A leaf drops the family word when it
 *                   would repeat it (hex64_parse -> dftu.hex.parse64).
 *     fn          - the dftu_* C ABI function implementing it.
 *     ret,o0..o2  - the signature tokens (DFTU_TOK_* suffixes): the return
 *                   token then up to three operand tokens, packed by
 *                   DFTU_OP_SIG. Pad unused operand slots with NONE.
 *
 * Only host utilities that are genuine column kernels belong here. The file
 * and filesystem families (dftu.fs.*, dftu.file.*, dftu.text.line_filter) are
 * I/O, not kernels: they register into the same name-keyed registry at runtime
 * from the utilities layer (utilities/host_ops.h) via dftu_op_register, so the
 * columnar engine keeps no dependency on the file system.
 *
 * This is the whole column-op surface (every dftu_series_* op). Frame ops
 * (dftu_dataframe_*: join / group_by / pivot / select / ...) are a separate
 * family (a different handle and string-keyed config), registered under
 * `dftu.frame.<op>` in exported_frame_ops.def.
 */

#ifndef DFTU_SERIES_OP
#define DFTU_SERIES_OP(name, fn, ret, o0, o1, o2)
#endif

/* Elementwise arithmetic (column op column). */
DFTU_SERIES_OP(dftu.series.add, dftu_series_add, SERIES, SERIES, SERIES, NONE)
DFTU_SERIES_OP(dftu.series.sub, dftu_series_sub, SERIES, SERIES, SERIES, NONE)
DFTU_SERIES_OP(dftu.series.mul, dftu_series_mul, SERIES, SERIES, SERIES, NONE)
DFTU_SERIES_OP(dftu.series.div, dftu_series_div, SERIES, SERIES, SERIES, NONE)

/* Broadcast a scalar across a column. */
DFTU_SERIES_OP(dftu.series.add_scalar, dftu_series_add_scalar, SERIES, SERIES, SCALAR, NONE)
DFTU_SERIES_OP(dftu.series.sub_scalar, dftu_series_sub_scalar, SERIES, SERIES, SCALAR, NONE)
DFTU_SERIES_OP(dftu.series.mul_scalar, dftu_series_mul_scalar, SERIES, SERIES, SCALAR, NONE)
DFTU_SERIES_OP(dftu.series.div_scalar, dftu_series_div_scalar, SERIES, SERIES, SCALAR, NONE)

/* Compare / filter / cast / numeric prim. */
DFTU_SERIES_OP(dftu.series.compare, dftu_series_compare, SERIES, SERIES, CMP, SCALAR)
DFTU_SERIES_OP(dftu.series.filter_gt, dftu_series_filter_gt, SERIES, SERIES, SCALAR, NONE)
DFTU_SERIES_OP(dftu.series.filter, dftu_series_filter, SERIES, SERIES, SERIES, NONE)
DFTU_SERIES_OP(dftu.series.where, dftu_series_where, SERIES, SERIES, SERIES, SERIES)
DFTU_SERIES_OP(dftu.series.cast, dftu_series_cast, SERIES, SERIES, DTYPE, NONE)
DFTU_SERIES_OP(dftu.series.prim, dftu_series_prim, SERIES, SERIES, PRIM, NONE)

/* Boolean ops on Bool columns. */
DFTU_SERIES_OP(dftu.series.logical, dftu_series_logical, SERIES, SERIES, SERIES, LOGICAL)
DFTU_SERIES_OP(dftu.series.logical_not, dftu_series_logical_not, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.dictionary_encode, dftu_series_dictionary_encode, SERIES, SERIES,
               NONE, NONE)

/* String predicates (column, literal -> Bool). */
DFTU_SERIES_OP(dftu.series.str_eq, dftu_series_str_eq, SERIES, SERIES, STR, NONE)
DFTU_SERIES_OP(dftu.series.str_contains, dftu_series_str_contains, SERIES, SERIES, STR, NONE)
DFTU_SERIES_OP(dftu.series.str_starts_with, dftu_series_str_starts_with, SERIES, SERIES, STR,
