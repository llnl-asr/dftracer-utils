cat == "POSIX" and dur >= 1000
---
name like "%Send%"
---
name == "a\"b" or name == 'it\'s' or name == "tab\there\u00e9" or path ~ "\d+\.h5"
---
name ilike "%send%" escape "\\"
---
"io" in cat
---
"io" not in cat
---
a ~* "x"
---
a !~ "^x" or b ~ "y"
---
not a == 1
---
any(tags) == "y"
---
x is null or y is not missing
---
ts between 1s and 5s and dur > 250ms
---
x in [1, 2, 3] and y not in ['a', 'b']
---
5-3 == 2 and -x < 10us and a // 2 % 3 == 1.5 * 2 / 4
---
(a ?? b) + 1 > 5ns
---
args.`cpu.idle_pct` > 0.5 and hosts[0].name == $host and a[-1] == 1
---
`from` == 1 and counters.`cpu.idle_pct`.p50 > 2
---
x not in (from runs | select run)
---
x in (from "a.pfw.gz", $f, runs | where y > 1)
---
run in (from runs | where app == "laghos" | select run)
---
run -> runs.app == "laghos"
---
run -> runs(id).app == "laghos"
---
run -> runs.system -> systems.cpu == "a64fx"
---
(run, host) -> hosts.name != "h1"
---
myplug.entropy(args.data, n = 5) > 0.5
---
any(hosts, .ok) and all(tags, . != 'x') and ^.id == 1
---
where x > 1 | derive y = x * 2, z = y + 1
---
from "a.pfw.gz", 'b.pfw.gz' | select name, dur as d, t = ts // 1000
---
from all | drop args.x, pid | rename p = pid, t = tid
---
distinct | distinct name, cat
---
group name, cat { n = count(), total = sum(dur), p = quantile(dur, 0.99) }
---
agg { n = count(), busy = busy() }
---
window name sort ts { r = row_number(), prev = lag(dur, 1) }
---
window { r = running_sum(dur) }
---
pivot cat in ["POSIX", "STDIO"] { n = count() }
---
pivot cat { t = sum(dur) }
---
unpivot read_bytes, write_bytes as kind, bytes
---
sort -dur, name nulls first, ts nulls last, - -x, a - b
---
take 10 | take 5 by name sort -dur | skip 3
---
sample 100 seed 7 | sample 12.5 % | sample 5 %
---
expand hosts as h with_index i keep_empty | where .ok and ^.id == 1
---
lookup runs on run | lookup hosts on (run, host) into hs | expand hs keep_empty
---
lookup runs on run == id, (a, b) == (c, d), -x == y + 1 into r
---
lookup s on pid asof ts == t | lookup s on pid asof ts forward within 5 | lookup s on (a, b) == (c, d) asof ts nearest within $w | lookup s on pid asof ts within 5ms | lookup s on pid asof ts backward within 1.5
---
lookup s on pid overlap | lookup s on (a, b) == (c, d) overlap into m
---
lookup runs on run inner | lookup runs on run inner into r | lookup runs on run anti
---
lookup (from runs | select run) on run | lookup (from runs) on run inner into r | lookup (from runs) on run anti
---
lookup (from s | select pid, ts) on pid asof ts | lookup (from s) on pid overlap into m
---
where inner == 1 and anti > 2 | derive anti = inner + 1
---
union (from runs | select run)
---
call myplug.table(x, n = 5) | call_tree
---
time_range 1s .. 5s overlap | bucket 100ms fill
---
bucket 5s every 1s | agg { n = count() }
---
bucket 1d every 1h | agg { n = count() }
---
bucket 2ms at 1ms | agg { n = count() }
---
bucket 5s every 1s at $t0 fill forward from 0 to 10s as w | agg { n = count() }
---
bucket $w every $e | agg { n = count() }
---
time_range $start..$end | bucket 1m
---
bucket 1ms fill forward | agg { n = count() }
---
bucket 1ms fill linear from 0 to 6ms as b | agg { n = count() }
---
bucket $w fill from $lo - 1s to ($hi + 2) * 3 / 2 as b | agg { n = count() }
---
distinct c = cat, dur // 10 as d | pivot k in ["a" as x, "b"] { n = count() } | take 3..5 | take $a..$b
---
where name in $names and name not in $skip and path like $p and path not ilike $q escape "!"
---
time_range $t0 .. $t0 + 10s | time_range 1s .. | time_range .. 5s overlap | bucket 1s fill as sec | sample $n seed $s | union runs | union "b.pfw.gz"
---
duql 1
let runs = where type == "run";
where run -> runs.app == "laghos"
---
def ms(x) = x / 1000;
def big = dur > 1s;
where ms(dur) > 5 and big()
---
# genesis source
source genesis {
    data = where gtype != "run";
    runs = where gtype == "run"
}
---
source dftracer {
    data    = where ph != "M";
    files   = where ph == "M" and name == "FH" | select id = args.value, path = args.name;
    hosts   = where ph == "M" and name == "HH" | select id = args.value, name = args.name;
    strings = where ph == "M" and name == "SH" | select id = args.value, value = args.name;
    def ms(x) = x / 1000;
    def args_fallback = true
}
where ms(dur) > 1   # trailing comment
---
source s { data = where x > 1; def f(a, b) = a + b; }
f(1, 2) > 0
---
def io_rate(d) = where cat == "POSIX" | bucket d | agg { b = sum(size) };
from data | io_rate(1ms) | sort b
---
def pos = where cat == "POSIX";
def rate(d) = pos() | bucket d | agg { n = count() };
rate(1ms) | sort n
---
io_rate(1ms) | sort b
---
