DFTU_SERIES_OP(dftu.series.to_uppercase, dftu_series_to_uppercase, SERIES, SERIES, NONE,
               NONE)
DFTU_SERIES_OP(dftu.series.str_strip, dftu_series_str_strip, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.str_lstrip, dftu_series_str_lstrip, SERIES, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.str_rstrip, dftu_series_str_rstrip, SERIES, SERIES, NONE, NONE)

/* String edits (column + literal args). */
DFTU_SERIES_OP(dftu.series.str_replace, dftu_series_str_replace, SERIES, SERIES, STR, STR)
DFTU_SERIES_OP(dftu.series.str_replace_all, dftu_series_str_replace_all, SERIES, SERIES, STR,
               STR)
DFTU_SERIES_OP(dftu.series.str_slice, dftu_series_str_slice, SERIES, SERIES, I64, I64)
DFTU_SERIES_OP(dftu.series.str_pad_start, dftu_series_str_pad_start, SERIES, SERIES, I64,
               CHAR)
DFTU_SERIES_OP(dftu.series.str_pad_end, dftu_series_str_pad_end, SERIES, SERIES, I64, CHAR)
DFTU_SERIES_OP(dftu.series.str_zfill, dftu_series_str_zfill, SERIES, SERIES, I64, NONE)
DFTU_SERIES_OP(dftu.series.str_split, dftu_series_str_split, SERIES, SERIES, STR, NONE)

/* Reducers (column -> scalar). */
DFTU_SERIES_OP(dftu.series.reduce, dftu_series_reduce, SCALAR, SERIES, REDUCE, NONE)
DFTU_SERIES_OP(dftu.series.count, dftu_series_count, I64, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.product, dftu_series_product, SCALAR, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.all, dftu_series_all, BOOL, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.any, dftu_series_any, BOOL, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.arg_min, dftu_series_arg_min, I64, SERIES, NONE, NONE)
DFTU_SERIES_OP(dftu.series.arg_max, dftu_series_arg_max, I64, SERIES, NONE, NONE)
