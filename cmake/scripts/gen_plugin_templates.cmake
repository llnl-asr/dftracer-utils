# SPDX-License-Identifier: MIT
# Writes the header `dftracer_plugin new` embeds its scaffolds from: every file
# under TEMPLATE_DIR, as bytes, so the tool never looks for a share directory at
# run time. src/CMakeLists.txt runs this at build time as a custom command, and
# its file list uses CONFIGURE_DEPENDS, so a new template file is picked up
# without a reconfigure:
#   cmake -DTEMPLATE_DIR=<dir> -DOUT=<header> -P gen_plugin_templates.cmake
if(NOT TEMPLATE_DIR OR NOT OUT)
  message(FATAL_ERROR "gen_plugin_templates.cmake needs TEMPLATE_DIR and OUT")
endif()

file(GLOB_RECURSE files RELATIVE "${TEMPLATE_DIR}" "${TEMPLATE_DIR}/*")
list(SORT files)

set(body "")
set(entries "")
foreach(file ${files})
  file(READ "${TEMPLATE_DIR}/${file}" hex HEX)
  string(LENGTH "${hex}" hex_length)
  math(EXPR byte_length "${hex_length} / 2")
  string(REGEX REPLACE "(..)" "0x\\1," bytes "${hex}")
  string(MAKE_C_IDENTIFIER "${file}" id)
  string(APPEND body
         "inline constexpr unsigned char TEMPLATE_${id}[] = {${bytes}0};\n")
  if(file MATCHES "\\.gz$")
    set(is_text false)
  else()
    set(is_text true)
  endif()
  string(APPEND entries
         "    {\"${file}\", ${byte_length}, ${is_text},\n"
         "     reinterpret_cast<const char*>(detail::TEMPLATE_${id})},\n")
endforeach()

file(
  WRITE "${OUT}"
  "// SPDX-License-Identifier: MIT
// Generated by cmake/scripts/gen_plugin_templates.cmake from the files under
// src/dftracer/utils/cli/plugin_templates/. Do not edit: change a template
// file and configure again.
#ifndef DFTRACER_UTILS_CLI_PLUGIN_TEMPLATES_H
#define DFTRACER_UTILS_CLI_PLUGIN_TEMPLATES_H

#include <cstddef>

namespace dftracer::utils::cli {

/// One embedded template file: the path it lands on relative to its kind
/// folder, its bytes, and whether it is text (@NAME@ is substituted in text
/// only, so no binary file is ever walked as a string).
struct PluginTemplate {
    const char* path;
    std::size_t size;
    bool is_text;
    const char* data;
};

namespace detail {
${body}}  // namespace detail

/// Every template file, sorted by path.
inline const PluginTemplate PLUGIN_TEMPLATES[] = {
${entries}};

inline const std::size_t PLUGIN_TEMPLATE_COUNT =
    sizeof(PLUGIN_TEMPLATES) / sizeof(PLUGIN_TEMPLATES[0]);

}  // namespace dftracer::utils::cli

#endif  // DFTRACER_UTILS_CLI_PLUGIN_TEMPLATES_H
")
message(STATUS "wrote ${OUT}")
