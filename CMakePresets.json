{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development (RelWithDebInfo)",
      "description": "Development build with optimizations and debug info",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/build-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DFTRACER_UTILS_BUILD_SHARED": "ON",
        "DFTRACER_UTILS_BUILD_STATIC": "ON",
        "DFTRACER_UTILS_BUILD_BINARIES": "ON",
        "DFTRACER_UTILS_BUILD_PYTHON": "OFF",
        "DFTRACER_UTILS_DEBUG": "OFF"
      }
    },
    {
      "name": "dev-python",
      "displayName": "Development with Python (RelWithDebInfo)",
      "description": "Development build with Python bindings",
      "inherits": "dev",
      "cacheVariables": {
        "DFTRACER_UTILS_BUILD_PYTHON": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with verbose logging",
      "inherits": "dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DFTRACER_UTILS_DEBUG": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized release build",
      "inherits": "dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DFTRACER_UTILS_DEBUG": "OFF"
      }
    },
    {
      "name": "bench",
      "displayName": "Benchmarks (Release)",
      "description": "Release build with the standalone benchmarks; the smoke ctests need DFTRACER_UTILS_TESTS",
      "inherits": "release",
      "cacheVariables": {
        "DFTRACER_UTILS_BUILD_BENCHMARKS": "ON",
        "DFTRACER_UTILS_TRACKED_BYTES": "ON",
        "DFTRACER_UTILS_TESTS": "ON",
        "DFTRACER_UTILS_BUILD_PYTHON": "ON",
        "DFTRACER_UTILS_BUILD_STATIC": "OFF"
      }
    },
    {
      "name": "shared-only",
      "displayName": "Shared Library Only (RelWithDebInfo)",
      "description": "Build only shared library",
      "inherits": "dev",
      "cacheVariables": {
        "DFTRACER_UTILS_BUILD_STATIC": "OFF"
      }
    },
    {
      "name": "static-only",
      "displayName": "Static Library Only (RelWithDebInfo)",
      "description": "Build only static library",
      "inherits": "dev",
      "cacheVariables": {
        "DFTRACER_UTILS_BUILD_SHARED": "OFF",
        "DFTRACER_UTILS_BUILD_PYTHON": "OFF"
      }
    },
    {
      "name": "tests",
      "displayName": "Tests (RelWithDebInfo)",
      "description": "Build with tests enabled",
      "inherits": "dev",
      "cacheVariables": {
        "DFTRACER_UTILS_TESTS": "ON",
        "DFTRACER_UTILS_DEBUG": "ON",
        "DFTRACER_UTILS_BUILD_PYTHON": "ON",
        "DFTRACER_UTILS_BUILD_STATIC": "ON"
      }
    },
    {
      "name": "tests-single",
      "displayName": "Tests, single library (RelWithDebInfo)",
      "description": "Tests with one library dftracer_utils instead of one per area",
      "inherits": "tests",
      "binaryDir": "${sourceDir}/build/build-tests-single",
      "cacheVariables": {
        "DFTRACER_UTILS_SINGLE_LIBRARY": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (Debug + gcov/lcov)",
      "description": "Tests with coverage instrumentation enabled",
      "inherits": "tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DFTRACER_UTILS_COVERAGE": "ON",
        "DFTRACER_UTILS_BUILD_STATIC": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "Address Sanitizer (Debug)",
      "description": "Debug build with Address Sanitizer enabled",
      "inherits": "debug",
      "cacheVariables": {
        "DFTRACER_UTILS_TESTS": "ON",
        "DFTRACER_UTILS_MEMORY_BACKEND": "system",
        "DFTRACER_UTILS_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "Thread Sanitizer (Debug)",
      "description": "Debug build with Thread Sanitizer enabled",
      "inherits": "debug",
      "cacheVariables": {
        "DFTRACER_UTILS_TESTS": "ON",
        "DFTRACER_UTILS_MEMORY_BACKEND": "system",
        "DFTRACER_UTILS_ENABLE_TSAN": "ON",
        "DFTRACER_UTILS_COVERAGE": "OFF"
      }
    },
    {
      "name": "ubsan",
      "displayName": "UndefinedBehavior Sanitizer (Debug)",
      "description": "Debug build with UndefinedBehavior Sanitizer enabled",
      "inherits": "debug",
      "cacheVariables": {
        "DFTRACER_UTILS_TESTS": "ON",
        "DFTRACER_UTILS_MEMORY_BACKEND": "system",
        "DFTRACER_UTILS_ENABLE_UBSAN": "ON",
        "DFTRACER_UTILS_COVERAGE": "OFF"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "ASAN + UBSAN (Debug)",
      "description": "Debug build with Address and UndefinedBehavior Sanitizers",
      "inherits": "debug",
      "cacheVariables": {
        "DFTRACER_UTILS_TESTS": "ON",
        "DFTRACER_UTILS_MEMORY_BACKEND": "system",
        "DFTRACER_UTILS_ENABLE_ASAN": "ON",
        "DFTRACER_UTILS_ENABLE_UBSAN": "ON",
        "DFTRACER_UTILS_COVERAGE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "displayName": "Development Build",
      "configurePreset": "dev",
      "jobs": 0
    },
    {
      "name": "dev-python",
      "displayName": "Development Build with Python",
      "configurePreset": "dev-python",
      "jobs": 0
    },
    {
      "name": "debug",
      "displayName": "Debug Build",
      "configurePreset": "debug",
      "jobs": 0
    },
    {
      "name": "release",
      "displayName": "Release Build",
      "configurePreset": "release",
      "jobs": 0
    },
    {
      "name": "bench",
      "displayName": "Benchmarks Build",
      "configurePreset": "bench",
      "targets": [
        "view_api_bench",
        "index_bench",
        "duql_eval_bench",
        "group_transform_bench",
        "slice_bench",
        "dftracer_utils_ext"
      ],
      "jobs": 0
    },
    {
      "name": "shared-only",
      "displayName": "Shared Library Build",
      "configurePreset": "shared-only",
      "jobs": 0
    },
    {
      "name": "static-only",
      "displayName": "Static Library Build",
      "configurePreset": "static-only",
      "jobs": 0
    },
    {
      "name": "tests",
      "displayName": "Tests Build",
      "configurePreset": "tests",
      "jobs": 0
    },
    {
      "name": "tests-single",
      "displayName": "Tests Build (single library)",
      "configurePreset": "tests-single",
      "jobs": 0
    },
    {
      "name": "coverage",
      "displayName": "Coverage Build",
      "configurePreset": "coverage",
      "jobs": 0
    },
    {
      "name": "asan",
      "displayName": "ASAN Build",
      "configurePreset": "asan",
      "jobs": 0
    },
    {
      "name": "tsan",
      "displayName": "TSAN Build",
      "configurePreset": "tsan",
      "jobs": 0
    },
    {
      "name": "ubsan",
      "displayName": "UBSAN Build",
      "configurePreset": "ubsan",
      "jobs": 0
    },
    {
      "name": "asan-ubsan",
      "displayName": "ASAN+UBSAN Build",
      "configurePreset": "asan-ubsan",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "tests",
      "displayName": "Run Tests",
      "configurePreset": "tests",
      "environment": {
        "DFTRACER_UTILS_ELASTIC": "0",
        "DFTRACER_UTILS_MEMORY_EXIT_CHECK": "1"
      },
      "execution": {
        "jobs": 0
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tests-single",
      "displayName": "Run Tests (single library)",
      "configurePreset": "tests-single",
      "environment": {
        "DFTRACER_UTILS_ELASTIC": "0",
        "DFTRACER_UTILS_MEMORY_EXIT_CHECK": "1"
      },
      "execution": {
        "jobs": 0
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "displayName": "Run Tests (coverage)",
      "configurePreset": "coverage",
      "environment": {
        "DFTRACER_UTILS_ELASTIC": "0"
      },
      "execution": {
        "jobs": 0
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "displayName": "Run ASAN Tests",
      "configurePreset": "asan",
      "environment": {
        "DFTRACER_UTILS_ELASTIC": "0"
      },
      "execution": {
        "jobs": 0
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "displayName": "Run TSAN Tests",
      "configurePreset": "tsan",
      "environment": {
        "TSAN_OPTIONS": "suppressions=${sourceDir}/tests/tsan/tsan.supp",
        "DFTRACER_UTILS_ELASTIC": "0"
      },
      "execution": {
        "jobs": 0
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ubsan",
      "displayName": "Run UBSAN Tests",
      "configurePreset": "ubsan",
      "environment": {
        "DFTRACER_UTILS_ELASTIC": "0"
      },
      "execution": {
        "jobs": 0
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "Run ASAN+UBSAN Tests",
      "configurePreset": "asan-ubsan",
      "environment": {
        "DFTRACER_UTILS_ELASTIC": "0"
      },
      "execution": {
        "jobs": 0
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "bench",
      "displayName": "Run Benchmark Smoke Tests",
      "configurePreset": "bench",
      "environment": {
        "DFTRACER_UTILS_ELASTIC": "0"
      },
      "execution": {
        "jobs": 1
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
